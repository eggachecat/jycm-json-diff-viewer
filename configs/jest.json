{
  "rootDir": "..",
  "testEnvironment": "jsdom",
  "coverageDirectory": "<rootDir>/tests/__coverage__/",
  "setupFiles": ["<rootDir>/tests/__mocks__/shim.js"],
  "roots": ["<rootDir>/src/", "<rootDir>/tests/"],
  "moduleNameMapper": {
    "^react-jycm-viewer$": "<rootDir>/tests/__mocks__/reactJycmViewer.tsx",
    "^react-monaco-editor$": "<rootDir>/tests/__mocks__/reactMonacoEditor.tsx",
    "^react-virtualized/dist/commonjs/AutoSizer$": "<rootDir>/tests/__mocks__/autoSizer.tsx",
    "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/tests/__mocks__/fileMock.js",
    "\\.(css|scss|less)$": "<rootDir>/tests/__mocks__/styleMock.js"
  },
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx"],
  "transformIgnorePatterns": ["/node_modules/"],
  "testRegex": "/tests/.*\\.test\\.(ts|tsx)$",
  "moduleDirectories": ["node_modules"],
  "globals": {
    "DEVELOPMENT": false,
    "FAKE_SERVER": false
  }
}
