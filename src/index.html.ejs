<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>JYCM — Semantic JSON Diff Playground</title>
    <meta
      name="description"
      content="Design business-aware JSON diffs, explain named rule outcomes, generate and apply semantic RFC 6902 patches, and inspect synchronized changes with JYCM."
    />
    <meta
      name="keywords"
      content="semantic JSON diff, JSON Patch, RFC 6902, business diff policy, JSON compare, array identity matching, JYCM, Agent Skill"
    />
    <meta name="theme-color" content="#0b2119" />
    <link
      rel="canonical"
      href="https://eggachecat.github.io/jycm-json-diff-viewer/"
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="JYCM — Compare JSON by what your business actually means"
    />
    <meta
      property="og:description"
      content="A complete business diff workbench with versioned policies, explanations, semantic JSON Patch, Agent Skill installation, and synchronized visual inspection."
    />
    <meta
      property="og:url"
      content="https://eggachecat.github.io/jycm-json-diff-viewer/"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "JYCM Semantic JSON Diff Playground",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "url": "https://eggachecat.github.io/jycm-json-diff-viewer/",
        "codeRepository": "https://github.com/eggachecat/jycm-json-diff-viewer",
        "description": "Design, explain, patch, and visualize JSON using portable business policies, semantic RFC 6902 operations, and agent-ready workflows.",
        "license": "https://opensource.org/licenses/MIT"
      }
    </script>
  </head>
  <body>
    <div id="root"></div>

    <!-- Dependencies -->
    <% if (webpackConfig.mode == 'production') { %>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/react/17.0.2/umd/react.production.min.js"
      integrity="sha512-qlzIeUtTg7eBpmEaS12NZgxz52YYZVF5myj89mjJEesBd/oE9UPsYOX2QAXzvOAZYEvQohKdcY8zKE02ifXDmA=="
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/17.0.2/umd/react-dom.production.min.js"
      integrity="sha512-9jGNr5Piwe8nzLLYTk8QrEMPfjGU0px80GYzKZUxi7lmCfrBjtyCc1V5kkS5vxVwwIB7Qpzc7UxLiQxfAN30dw=="
      crossorigin="anonymous"
    ></script>
    <% } else { %>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/react/17.0.2/umd/react.development.js"
      integrity="sha512-Vf2xGDzpqUOEIKO+X2rgTLWPY+65++WPwCHkX2nFMu9IcstumPsf/uKKRd5prX3wOu8Q0GBylRpsDB26R6ExOg=="
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/17.0.2/umd/react-dom.development.min.js"
      integrity="sha512-aNBFq6ue8EmNDwVD/l0mWFy3iVZLIxtQaD7fEYBn3HluJer36T1AhJK0THj6MKKfhZrexxWsKX1T16TxLZo6uQ=="
      crossorigin="anonymous"
    ></script>
    <% } %>
  </body>
</html>
