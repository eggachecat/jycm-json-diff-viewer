{
  "name": "jycm-json-diff-viewer",
  "version": "0.1.0",
  "description": "Interactive semantic JSON diff playground powered by JYCM.",
  "keywords": [
    "json diff",
    "semantic diff",
    "json compare",
    "jycm",
    "custom diff rules",
    "react"
  ],
  "author": "eggachecat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggachecat/jycm-json-diff-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/eggachecat/jycm-json-diff-viewer/issues"
  },
  "homepage": "https://eggachecat.github.io/jycm-json-diff-viewer/",
  "scripts": {
    "build": "pnpm run clean-dist && webpack --config=configs/webpack/prod.js",
    "clean-dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src --ext .js,.ts,.tsx --quiet",
    "start": "pnpm run start-dev",
    "start-dev": "webpack serve --config=configs/webpack/dev.js",
    "start-prod": "pnpm run build && node express.js",
    "test": "jest --coverage --runInBand --config=configs/jest.json",
    "check": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.9",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@types/jest": "^27.4.1",
    "@types/node": "^17.0.24",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.14",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "babel-loader": "^8.2.4",
    "css-loader": "^6.7.1",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.4",
    "express": "^4.17.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^27.5.1",
    "monaco-editor-webpack-plugin": "^7.0.1",
    "sass": "^1.77.8",
    "prettier": "^2.6.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-hot-loader": "^4.13.0",
    "rimraf": "^3.0.2",
    "sass-loader": "^12.6.0",
    "style-loader": "^3.3.1",
    "typescript": "^4.6.3",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.8.1",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@types/react-virtualized": "^9.21.29",
    "jycm": "^0.2.0",
    "monaco-editor": "^0.33.0",
    "react-jycm-viewer": "0.0.7",
    "react-monaco-editor": "^0.48.0",
    "react-virtualized": "^9.22.5"
  }
}
